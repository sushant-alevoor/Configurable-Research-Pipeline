# Copy this file to .env and fill in your real keys.
# .env is gitignored — never commit real keys.

# Required — used whenever a lane/profile's llmProvider is "anthropic"
# (the default) for curation and matching, and whenever a lane's
# searchProvider is "claude" for search.
ANTHROPIC_API_KEY=sk-ant-...

# Optional — only needed if a config profile sets llmProvider to "gemini"
# for curation/matching on any lane, or for the matcher.
GEMINI_API_KEY=...

# Optional — only needed if a config profile sets llmProvider to "groq"
# for curation/matching on any lane, or for the matcher. Free tier: 30
# requests/minute, 6,000 tokens/minute, 14,400 requests/day — keep
# curatorBatchSize modest (10-12) on lanes using this provider.
GROQ_API_KEY=gsk_...

# Optional — only needed if a lane's searchProvider is set to "tavily"
TAVILY_API_KEY=tvly-...

# Optional — only needed if a lane's searchProvider is set to "exa"
EXA_API_KEY=...
